# Wajib: Discord Bot Token (dapat dari https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# Opsional: batasi siapa yang bisa pakai bot (koma-pisah ID Discord user)
# Kosongkan = semua user bisa pakai
DISCORD_ADMIN_IDS=

# Opsional: override kunci XL (default dari reverse engineering sudah diset)
# XL_XDATA_KEY=
# XL_AX_API_SIG_KEY=
# XL_X_API_BASE_SECRET=
# XL_ENCRYPTED_FIELD_KEY=

# Opsional: path data session (default: ./data/)
# XL_DATA_DIR=