# Wajib: sesi login XL (dibuat otomatis saat login OTP — disimpan di data/last_tokens.json)
# Tidak perlu diisi manual.

# Opsional: override kunci XL (default dari reverse engineering sudah diset)
# XL_XDATA_KEY=
# XL_AX_API_SIG_KEY=
# XL_X_API_BASE_SECRET=
# XL_ENCRYPTED_FIELD_KEY=
# XL_AX_FINGERPRINT=
# XL_AX_DEVICE_ID=

# Opsional: path data session (default: ./data/)
# XL_DATA_DIR=